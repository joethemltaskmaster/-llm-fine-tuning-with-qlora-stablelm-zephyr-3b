# Hugging Face Hub authentication token.
# Required if model_name or dataset_name point to a gated/private repo,
# or to avoid anonymous rate limits when downloading models/datasets.
HF_TOKEN=

# PyTorch CUDA memory allocator config.
# Helps reduce fragmentation-related OutOfMemoryError on GPUs with
# limited VRAM (e.g. T4). Already set automatically in scripts/run_train.sh,
# but can be overridden here.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# CUDA device visibility. Restrict training to a specific GPU index
# if multiple GPUs are present.
CUDA_VISIBLE_DEVICES=0

# Optional: Weights & Biases API key, if you switch report_to from
# "tensorboard" to "wandb" in TrainingArguments.
WANDB_API_KEY=
